# This is the configuration file for the benchmarks

# ===== Target ======
# Define on which core the load and the measure will run

CPU_TARGET_LOAD=1
CPU_TARGET_TURBOSTAT=9

# ==== CPU load ====
CPU_N_PI=9000000
N_CPU=0
CPU_LOG_PATH=data/cpu.txt

# == memory load ===
MEMORY_N_JUMPS=7000000
N_MEMORY=0
MEMORY_LOG_PATH=data/memory.txt

# ==== IO load =====
IO_PURGE_CACHE=1
IO_RANDOM_OFFSET=0
IO_N_DUMPS=50
IO_SIZE_DUMP=25
N_IO=0
IO_LOG_PATH=data/io.txt

# ==== Sleep load ====
SLEEP_DURATION=1000
# ^ in ms, if set to -1 the duration will be random between 100 and 2000
SLEEP_COUNT=5
SLEEP_LOG_PATH=data/sleep.txt
N_SLEEP=50